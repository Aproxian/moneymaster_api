# Copy to .env and fill in values. Never commit .env.

# --- Runtime DB (MariaDB adapter in src/prisma.js) ---
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=moneymaster_dev

# --- Prisma CLI (migrate / studio) — MySQL connection string ---
# Example: mysql://USER:PASSWORD@127.0.0.1:3306/DATABASE_NAME
DATABASE_URL=mysql://root:@127.0.0.1:3306/moneymaster_dev

# --- Auth (use long random strings in production) ---
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh

# Optional: refresh session lifetime (days, 1–365)
REFRESH_TTL_DAYS=90

# Optional: operator email for admin-only routes (case-insensitive)
ADMIN_EMAIL=

# Optional
PORT=3000
