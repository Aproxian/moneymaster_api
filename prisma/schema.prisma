datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum TxType {
  INCOME
  EXPENSE
  INVESTMENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  CURRENCY_CHANGE
  TRANSFER_CREATE
  MEMBER_ADD
  MEMBER_REMOVE
  LOGIN
  LOGOUT
}

enum AssetType {
  STOCK
  ETF
  INDEX
  CRYPTO
  FOREX
  FUTURE
  COMMODITY
  BOND
  FUND
  OTHER
}

enum MarketDataProvider {
  TWELVEDATA
  FINNHUB
  POLYGON
  ALPHAVANTAGE
  OTHER
}

enum ScheduleKind {
  DELAY_ONCE
  RECURRING
}

enum ScheduleStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum RecurrenceUnit {
  HOUR
  DAY
  WEEK
  MONTH
  YEAR
}

enum MembershipNoticeKind {
  REMOVED
  ACCOUNT_DELETED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String?
  /// Ledger created at signup (“Personal”); members cannot be added to this book.
  personalAccountId String? @unique
  /// First day of week for calendars: 0=Sun … 6=Sat (like JS getDay). Default 1=Monday.
  firstDayOfWeek Int @default(1)
  /// App-level lock after login (separate from this password field).
  appLockEnabled       Boolean @default(false)
  appLockPasswordHash  String? @db.VarChar(255)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  /// Soft-delete: user cannot sign in; data retained for audit.
  deletedAt    DateTime?

  memberships     AccountMember[]
  sessions          Session[]
  audits            AuditLog[]
  personalAccount   Account? @relation("UserPersonalAccount", fields: [personalAccountId], references: [id], onDelete: SetNull)

  categoriesCreated       Category[]              @relation("CategoryCreatedBy")
  categoryMemberAccessRows CategoryMemberAccess[]

  // ✅ FIX: add relation name + add the other missing opposite relations
  initiatedTransfers  TransferGroup[]         @relation("InitiatedTransfers")
  createdTransactions Transaction[]           @relation("TxCreatedBy")
  currencyChanges     AccountCurrencyChange[] @relation("CurrencyChangedBy")
  schedulesCreated    PendingTransactionSchedule[] @relation("ScheduleCreatedBy")
  membershipNotices   MembershipNotice[]

  @@index([deletedAt])
}

model MembershipNotice {
  id          String               @id @default(cuid())
  userId      String
  kind        MembershipNoticeKind
  accountId   String
  accountName String?              @db.VarChar(200)
  createdAt   DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ip               String?
  revokedAt        DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id        String    @id @default(cuid())
  name      String
  currency  String    @default("EUR")
  /// When true, user splits cash flow into emoji wallets (cash/card defaults on enable).
  walletsEnabled Boolean @default(false)
  /// True while first-time wallet setup is in progress; wallets exist but feature is not live until completed.
  walletMigrationPending Boolean @default(false)
  /// When false, investment UI and flows are hidden; no holdings may remain before turning off.
  investingEnabled Boolean @default(true)
  /// When true, expenses and outgoing cross-account transfers cannot bring (income − expense) cash balance below zero.
  preventNegativeCashBalance Boolean @default(false)
  isBusiness Boolean  @default(false)
  companyName      String? @db.VarChar(200)
  companyLegalName String? @db.VarChar(200)
  companyTaxId     String? @db.VarChar(80)
  companyAddress   String? @db.Text
  companyNotes     String? @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members        AccountMember[]
  categories     Category[]
  transactions   Transaction[]
  wallets        AccountWallet[]
  currencyEvents AccountCurrencyChange[]
  holdings       Holding[]

  transfersFrom TransferGroup[] @relation("FromAccount")
  transfersTo   TransferGroup[] @relation("ToAccount")
  userPersonalFor User[]          @relation("UserPersonalAccount")
  pendingSchedules PendingTransactionSchedule[]

  @@index([createdAt])
  @@index([deletedAt])
}

model PendingTransactionSchedule {
  id              String          @id @default(cuid())
  accountId       String
  createdByUserId String
  kind            ScheduleKind
  status          ScheduleStatus  @default(PENDING)
  /// One-shot: when to materialize the row.
  executeAt       DateTime?
  recurrenceUnit  RecurrenceUnit?
  intervalCount   Int             @default(1)
  /// 0–23 UTC hour when unit is DAY or longer (optional for HOUR).
  hourOfDay       Int?
  nextRunAt       DateTime
  lastRunAt       DateTime?
  payload         Json
  cancelledAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ScheduleCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([accountId, status, nextRunAt])
  @@index([createdByUserId])
}

model AccountWallet {
  id          String    @id @default(cuid())
  accountId   String
  emoji       String    @db.VarChar(16)
  sortOrder   Int       @default(0)
  /// System wallets created on enable, e.g. WALLET_CASH / WALLET_CARD.
  internalKey String?   @db.VarChar(64)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([accountId])
  @@index([accountId, deletedAt])
}

model AccountMember {
  userId    String
  accountId String
  role      MemberRole @default(MEMBER)
  joinedAt  DateTime   @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([userId, accountId])
  @@index([accountId])
}

model Category {
  id        String    @id @default(cuid())
  accountId String
  type      TxType?
  name      String
  /// Order within the same `type` on the Categories screen (lower = first).
  sortOrder Int       @default(0)
  /// System use: e.g. INV_STOCKS, CASH_OUT_INVESTMENT. Omitted for user-created categories.
  internalKey String? @db.VarChar(64)
  /// When true, cannot be chosen for manual income/expense/investment entries (UI + API). Transfer legs use this; users may toggle for custom categories later.
  lockedForManualEntry Boolean @default(false)
  /// User who created this row (defaults seeded with the account owner). Null = legacy before tracking.
  createdByUserId String?
  /// Shared books only: when true, only the account primary owner + users in `memberAccessGrants` may use this category for manual entries (in addition to `lockedForManualEntry`).
  memberAccessRestricted Boolean @default(false)
  /// When `memberAccessRestricted` is true: new members get a grant row unless this is true.
  newMembersLockedByDefault Boolean @default(false)
  icon      String?
  color     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdBy    User?         @relation("CategoryCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  transactions Transaction[]
  holdings     Holding[]
  wishlistItems CategoryWishlistItem[]
  memberAccessGrants CategoryMemberAccess[]

  @@unique([accountId, type, name])
  @@index([accountId])
  @@index([accountId, type, sortOrder])
  @@index([deletedAt])
  @@index([createdByUserId])
}

/// Per-category manual-entry allow list for shared accounts (`memberAccessRestricted`).
model CategoryMemberAccess {
  categoryId String
  userId     String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([categoryId, userId])
  @@index([userId])
}

model TransferGroup {
  id            String    @id @default(cuid())
  initiatedById String
  fromAccountId String
  toAccountId   String
  fxRate        Decimal?  @db.Decimal(18, 8)
  note          String?
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  // ✅ FIX: relation name matches User.initiatedTransfers
  initiatedBy User @relation("InitiatedTransfers", fields: [initiatedById], references: [id], onDelete: Restrict)

  fromAccount Account @relation("FromAccount", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount   Account @relation("ToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)

  transactions Transaction[]

  @@index([fromAccountId, createdAt])
  @@index([toAccountId, createdAt])
  @@index([deletedAt])
}

model Transaction {
  id          String   @id @default(cuid())
  accountId   String
  type        TxType
  amountMinor Int
  currency    String
  occurredAt  DateTime
  note        String?

  categoryId      String?
  createdByUserId String?
  transferGroupId String?
  /// Same-account wallet↔wallet legs share this id (paired INCOME+EXPENSE).
  transferPairId  String?
  walletId        String?
  instrumentId    String?
  /// Units acquired on this INVESTMENT row (used to reverse holdings on revoke).
  investmentQuantity Decimal? @db.Decimal(36, 18)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  /// When set, excluded from balances and wheel; still listed in history until hard-deleted.
  revokedAt DateTime?
  /// When set, ledger row was created from schedule materialization (delayed once vs recurring).
  scheduleOriginKind ScheduleKind?

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // ✅ FIX: give this relation a name and match User.createdTransactions
  createdBy User? @relation("TxCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  transferGroup TransferGroup? @relation(fields: [transferGroupId], references: [id], onDelete: SetNull)

  wallet AccountWallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  instrument Instrument? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)

  @@index([accountId, occurredAt])
  @@index([categoryId])
  @@index([createdByUserId])
  @@index([transferGroupId])
  @@index([transferPairId])
  @@index([walletId])
  @@index([instrumentId])
  @@index([deletedAt])
  @@index([accountId, revokedAt])
}

model AccountCurrencyChange {
  id          String   @id @default(cuid())
  accountId   String
  changedById String
  oldCurrency String
  newCurrency String
  // "1 oldCurrency = fxRate newCurrency"
  fxRate      Decimal  @db.Decimal(18, 8)
  changedAt   DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // ✅ FIX: relation name matches User.currencyChanges
  changedBy User @relation("CurrencyChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([accountId, changedAt])
}

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([entity, entityId])
}

/// ---------- Investments v1 (Holdings only) ----------

model Instrument {
  id             String             @id @default(cuid())
  provider       MarketDataProvider
  providerSymbol String
  name           String
  type           AssetType
  currency       String?
  exchange       String             @default("")
  country        String?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  holdings     Holding[]
  quotes       QuoteCache[]
  transactions Transaction[]
  wishlistItems CategoryWishlistItem[]

  @@unique([provider, providerSymbol, exchange])
  @@index([type])
  @@index([isActive])
}

model Holding {
  id           String    @id @default(cuid())
  accountId    String
  instrumentId String
  categoryId   String?
  quantity     Decimal   @db.Decimal(36, 18)
  /// Sum of amountMinor from buys still reflected in this holding (account currency, minor units).
  costBasisMinor Int       @default(0)
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  account    Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  category   Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([accountId, instrumentId])
  @@index([accountId])
  @@index([instrumentId])
  @@index([categoryId])
  @@index([deletedAt])
}

model QuoteCache {
  id           String             @id @default(cuid())
  instrumentId String
  provider     MarketDataProvider
  price        Decimal            @db.Decimal(18, 8)
  currency     String?
  asOf         DateTime
  createdAt    DateTime           @default(now())

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@index([instrumentId, asOf])
  @@index([provider, asOf])
}

/// Single-row cursor for TWELVEDATA daily quote refresh when using minute-rate-limited chunk mode.
model TwelveDataQuoteRefreshState {
  id            String   @id
  nextOffset    Int      @default(0)
  totalSnapshot Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Single-row app-wide flags (e.g. API maintenance). Id is always `singleton`.
model GlobalAppState {
  id                   String   @id
  maintenanceMode      Boolean  @default(false)
  maintenanceMessage   String?  @db.VarChar(500)
  updatedAt            DateTime @updatedAt
}

/// Saved instruments per INVESTMENT category (wishlist) for quick pick when logging buys.
model CategoryWishlistItem {
  id           String   @id @default(cuid())
  categoryId   String
  instrumentId String
  createdAt    DateTime @default(now())

  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([categoryId, instrumentId])
  @@index([categoryId])
  @@index([instrumentId])
}
